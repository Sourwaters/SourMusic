{
 "rules": {
  ".read": false,
  ".write": false,
  "rooms": {
   "$room": {
    ".read": "auth != null && $room.matches(/^[a-f0-9]{64}$/)",
    ".write": "auth != null && $room.matches(/^[a-f0-9]{64}$/) && ((!data.exists() && newData.child('owner').val() === auth.uid) || data.child('owner').val() === auth.uid)",
    ".validate": "newData.hasChildren(['owner', 'online'])",
    "owner": {".validate": "newData.isString() && newData.val() === auth.uid && (!data.exists() || newData.val() === data.val())"},
    "online": {".validate": "newData.isBoolean()"},
    "state": {".validate": "newData.isString() && newData.val().length <= 8192"},
    "queue": {".validate": "newData.isString() && newData.val().length <= 65536"},
    "updatedAt": {".validate": "newData.isNumber() && newData.val() <= now + 1000"},
    "$other": {".validate": false}
   }
  }
 }
}
